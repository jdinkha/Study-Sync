# Ollama configuration for StudySync AI
# Copy this file to .env and edit as needed

# Which model to use by default (must be installed via `ollama pull <model>`)
# Examples: mistral, llama3, gemma, phi3, neural-chat, dolphin-mixtral
OLLAMA_MODEL=mistral

# Where Ollama is running (default is local)
OLLAMA_HOST=http://localhost:11434
